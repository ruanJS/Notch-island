{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notch Island",
  "version": "0.1.0",
  "identifier": "com.notchly.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "onboarding",
        "title": "Notch Island",
        "url": "index.html",
        "width": 820,
        "height": 620,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "alwaysOnTop": false,
        "skipTaskbar": false
      },
      {
        "label": "main",
        "title": "Notch Island",
        "url": "index.html",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "alwaysOnTop": false,
        "skipTaskbar": false
      },
      {
        "label": "widget",
        "title": "Notch Island Widget",
        "url": "index.html",
        "width": 146,
        "height": 552,
        "minWidth": 10,
        "minHeight": 10,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "preventOverflow": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "x": 50,
        "y": 200
      },
      {
        "label": "settings",
        "title": "Notch Island — Configurações",
        "url": "index.html",
        "width": 960,
        "height": 690,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
